{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --exec tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/seed.ts",
    "test:download-db": "node -e \"require('mongodb-memory-server-core').MongoBinary.getPath({}).then(p=>console.log('MongoDB binary ready:',p))\"",
    "test": "npm run test:download-db && vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
